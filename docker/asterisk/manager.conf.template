[general]
enabled = yes
port = 5038
; Bind só no loopback: o painel (mesmo container) usa 127.0.0.1.
; Em rede host isso mantém a AMI fora da internet.
bindaddr = 127.0.0.1
displayconnects = no

[magnus]
secret = ${AMI_SECRET}
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.0
read = system,call,log,verbose,agent,user,config,dtmf,reporting,cdr,dialplan
write = system,call,agent,user,config,command,reporting,originate
